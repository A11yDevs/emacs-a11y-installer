@startuml doctor-sequence-text
title Sequencia - emacs-a11y (modo interativo + doctor run)

actor Usuario
participant CLI
participant "Interactive Loop" as Loop
participant "Context Router" as Router
participant "Diagnostic Orchestrator" as Orch
participant "Check Registry" as Registry
participant "Platform Adapter" as Adapter
participant "Text Renderer" as TextRenderer
participant "Operating System" as OS

Usuario -> CLI : emacs-a11y
CLI -> Loop : start(root)
Loop --> Usuario : help contextual raiz
Usuario -> Loop : doctor
Loop -> Router : dispatch("doctor", root)
Router --> Loop : push(doctor)
Loop --> Usuario : help contextual doctor
Usuario -> Loop : run
Loop -> Router : dispatch("run", doctor)
Router -> Orch : run_diagnostic()
Orch -> Registry : load_checks(os)
Registry --> Orch : checks[]
Orch -> Adapter : collect_environment_state()
Adapter -> OS : read-only probes
OS --> Adapter : environment signals
Adapter --> Orch : EnvironmentState

loop for each check
  Orch -> Registry : execute(check, state)
  Registry --> Orch : DiagnosticResult
end

Orch -> TextRenderer : render(report)
TextRenderer --> Loop : formatted text
Loop --> Usuario : output
Usuario -> Loop : back
Loop -> Router : dispatch("back", doctor)
Router --> Loop : pop(root)
Loop --> Usuario : help contextual raiz
Usuario -> Loop : exit
Loop --> CLI : exit code
CLI --> Usuario : encerramento limpo

note over CLI,OS
All probes are read-only.
No file writes, installs, downloads,
PATH changes or privilege requests.
end note
@enduml
